# Backend API. On a simulator localhost works; on a physical device use your
# computer's LAN address, e.g. http://192.168.1.20:5000/api
EXPO_PUBLIC_API_URL=http://localhost:5000/api

# Groq — powers AI explanations and generated questions
EXPO_PUBLIC_GROQ_API_KEY=
EXPO_PUBLIC_GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# Gemini — optional alternative AI provider
EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_GEMINI_API_URL=
